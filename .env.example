# PostgreSQL
POSTGRES_USER=instapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=instapp
DATABASE_URL=postgresql+asyncpg://instapp:change_me@postgres:5432/instapp

# Redis
REDIS_URL=redis://redis:6379/0

# Security — 32 karakter olmalı
ENCRYPTION_KEY=change_me_32_chars_exactly_here!!

# Instagram — Chrome profil dizini (Playwright için)
CHROME_USER_DATA_DIR=/path/to/chrome/profile

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
