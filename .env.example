# Bu dosya yalnızca şablondur. Gerçek değerleri üretmek için:  python3 scripts/init_env.py
# (eksik değerleri rastgele doldurur, CREDENTIALS.md üretir; var olan değerlerin üzerine yazmaz)

# PostgreSQL
POSTGRES_USER=instaanalytic
POSTGRES_PASSWORD=
POSTGRES_DB=instaanalytic
DATABASE_URL=postgresql+asyncpg://instaanalytic:<POSTGRES_PASSWORD>@postgres:5432/instaanalytic

# Redis (parolalı)
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# Güvenlik
ENCRYPTION_KEY=          # kayıtlı oturumları şifreler; kaybedersen oturumlar çözülemez
ENCRYPTION_KEY_OLD=      # yalnızca anahtar rotasyonu sırasında (bkz. CREDENTIALS.md)
API_TOKEN=               # arayüz → API; Vite proxy ekler
HOST_AGENT_SECRET=       # ~/.instaanalytic_agent_secret ile aynı

# Flower (kuyruk monitörü) girişi
FLOWER_USER=admin
FLOWER_PASSWORD=

# App
ENVIRONMENT=production
LOG_LEVEL=INFO
