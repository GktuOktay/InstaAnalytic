# PostgreSQL
POSTGRES_USER=instapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=instapp
DATABASE_URL=postgresql+asyncpg://instapp:change_me@postgres:5432/instapp

# Redis
REDIS_URL=redis://redis:6379/0

# Security — rastgele güçlü bir şifre gir (uzunluk serbest, PBKDF2 ile türetilir)
ENCRYPTION_KEY=change_me_use_a_strong_random_passphrase

# Host Agent — ~/.instaanalytic_agent_secret dosyasındaki token ile eşleşmeli
HOST_AGENT_SECRET=

# Instagram — Chrome profil dizini (Playwright için)
CHROME_USER_DATA_DIR=/path/to/chrome/profile

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
