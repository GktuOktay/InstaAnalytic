{
  "manifest_version": 3,
  "name": "InstaAnalytic Köprüsü",
  "short_name": "IA Köprüsü",
  "version": "2.2.1",
  "description": "Kendi gönderilerinizin beğenenlerini, siz Instagram'da açtığınızda kaydeder. Instagram'a kendisi hiçbir istek göndermez.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "listener.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "InstaAnalytic Köprüsü",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
