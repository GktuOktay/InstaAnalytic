{
  "manifest_version": 3,
  "name": "InstaAnalytic Köprüsü",
  "short_name": "IA Köprüsü",
  "version": "1.0.0",
  "description": "Kendi gönderilerinizi kimin beğendiğini, açık Instagram sekmenizden yavaşça okuyup bu bilgisayardaki InstaAnalytic'e iletir.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "idle", "cookies", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "InstaAnalytic Köprüsü",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
